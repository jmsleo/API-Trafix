APP_NAME=api-trafix
APP_ENV=development
DEBUG=false

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://trafix:trafix@localhost:5432/trafix

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379/0

# JWT - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_IP_RATE_LIMIT=20
MAX_REQUEST_SIZE_MB=1
JWT_ISSUER=api-trafix
JWT_AUDIENCE=api-trafix-api

# CORS - JSON array of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Gate cycle - site identity printed on tickets
SITE_NAME=Trafix Parking
SITE_ADDRESS=Jl. Contoh No. 1
STORAGE_DIR=storage
API_BASE_URL=http://127.0.0.1:8000

# Gate cycle - MQTT bridge to the gate boards (leave disabled to use NullPublisher)
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_USERNAME=bssparking
MQTT_PASSWORD=BCTDev_2025
MQTT_CLIENT_ID_PREFIX=api-trafix

# Gate cycle - orchestrator policies
REQUIRE_PLATE_MATCH=false
COMMAND_EXIT_BARRIER=true
LPR_TIMEOUT_SECONDS=5.0
LPR_RETRIES=1
BUTTON_DEBOUNCE_SECONDS=5.0
BARRIER_PULSE_MS=1000
BARRIER_BEEP_MS=100
CARD_FALLBACK_TO_TICKET=true
